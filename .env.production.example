# Public domains used by Caddy
APP_DOMAIN=chat.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Public URLs consumed by the app
FRONTEND_PUBLIC_URL=https://chat.example.com
BACKEND_PUBLIC_URL=https://api.example.com
VITE_API_BASE_URL=https://api.example.com
FRONTEND_ORIGINS=https://chat.example.com
ALLOWED_ORIGIN_HOSTS=instagram.com,telegram.org,t.me,facebook.com,meta.com,snapchat.com

# Database
DATABASE_URL=
PGHOST=postgres
PGPORT=5432
PGDATABASE=fubotics
PGUSER=postgres
PGPASSWORD=change_me
POSTGRES_PASSWORD=change_me
PGSSL=false
DINO_KB_PGHOST=postgres
DINO_KB_PGPORT=5432

# Security
JWT_SECRET=change_me_to_a_long_random_secret
PUBLIC_IMAGE_SHARE_EXPIRY=30d

# Models
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
HUGGINGFACE_API_KEY=
HF_TOKEN=
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
HF_CHAT_MODEL=katanemo/Arch-Router-1.5B:hf-inference
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Dino
DINO_SELF_LEARNING=true
DINO_ALWAYS_WEB=false
DINO_AGENT_MODEL=llama-3.3-70b-versatile
DINO_AGENT_MAX_ITERATIONS=3
DINO_MCP_HTTP_PORT=5051
DINO_MCP_HTTP_URL=http://dino-mcp:5051
DINO_MCP_TOOL_TIMEOUT_MS=30000

# Coding Agent
CODING_AGENT_ENABLED=true
CODING_AGENT_MAX_ITERATIONS=3

# Serena MCP
SERENA_ENABLED=true
SERENA_MCP_URL=http://127.0.0.1:9121
SERENA_MCP_COMMAND=uv
SERENA_MCP_CONTEXT=ide-assistant
SERENA_MCP_ARGS_JSON=["tool","run","--from","git+https://github.com/oraios/serena","serena","start-mcp-server","--project-from-cwd","--context","ide-assistant"]
SERENA_MCP_TIMEOUT_MS=30000
SERENA_HTTP_BRIDGE_HOST=127.0.0.1
SERENA_HTTP_BRIDGE_PORT=9121
SERENA_MCP_CACHE_DIR=.uv-cache
SERENA_MCP_LINK_MODE=copy

# Search / token budgets
DEEP_SEARCH_MAX_RESULTS=4
DEEP_SEARCH_FETCH_CONCURRENCY=2
DEEP_SEARCH_SNIPPET_CHARS=700
DEEP_SEARCH_FETCH_PAGES=true
DEEP_SEARCH_SEARCH_TIMEOUT_MS=9000
DEEP_SEARCH_PAGE_TIMEOUT_MS=8000
AI_MAX_TOKENS=2048
AI_DEEP_SEARCH_MAX_TOKENS=3072
REQUEST_BODY_LIMIT=200mb
MAX_UPLOAD_FILE_SIZE_MB=200

# Image providers
ENABLE_FREEPIK=false
FREEPIK_API_KEY=
FREEPIK_IMAGE_MODEL=flux-pro-v1-1
LOCAL_IMAGE_WORKER_URL=
POLLINATIONS_BASE_URL=



