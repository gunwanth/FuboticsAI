server {
  listen ${PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }

  location = /health {
    access_log off;
    default_type application/json;
    return 200 '{"ok":true,"service":"fubotics-chat-frontend"}';
  }
}
